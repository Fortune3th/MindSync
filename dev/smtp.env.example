# Copy to smtp.env, replace all placeholders, then recreate the backend.
# Use a QQ Mail authorization code, not your mailbox or MindSync password.
# Keep single quotes around credentials to prevent Compose interpolation.
MINDSYNC_SMTP_HOST=smtp.qq.com
MINDSYNC_SMTP_PORT=465
MINDSYNC_SMTP_SECURITY=tls
MINDSYNC_SMTP_USERNAME='REPLACE_WITH_YOUR_QQ_EMAIL'
MINDSYNC_SMTP_PASSWORD='REPLACE_WITH_YOUR_QQ_AUTHORIZATION_CODE'
MINDSYNC_SMTP_FROM='MindSync <REPLACE_WITH_YOUR_QQ_EMAIL>'
