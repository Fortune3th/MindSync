# Copy to woodpecker.env and fill in. Never commit the filled file.

# Pin both images; "v3" is a moving tag, use a dated tag once it works.
WOODPECKER_SERVER_IMAGE=woodpeckerci/woodpecker-server:v3
WOODPECKER_AGENT_IMAGE=woodpeckerci/woodpecker-agent:v3

# LAN address of the NAS. Used for browser links and for Gitea webhooks,
# so it must resolve from the Gitea container as well.
WOODPECKER_HOST=http://192.168.1.10:8000
WOODPECKER_BIND_ADDRESS=0.0.0.0
WOODPECKER_PORT=8000

# Internal address of Gitea as seen from the Woodpecker server container.
GITEA_INTERNAL_URL=http://gitea:3000
GITEA_NETWORK=gitea_default

# Created in Gitea: Settings -> Applications -> Create OAuth2 Application.
# Redirect URI must be exactly ${WOODPECKER_HOST}/authorize
GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=

# Shared secret between server and agent. Generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=

# Your Gitea username. It becomes the Woodpecker administrator.
WOODPECKER_ADMIN=

WOODPECKER_MAX_WORKFLOWS=2
WOODPECKER_LOG_LEVEL=info
