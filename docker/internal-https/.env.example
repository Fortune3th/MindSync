# Resolve caddy:2-alpine once, then use its immutable repository digest.
MINDSYNC_CADDY_IMAGE=caddy:2-alpine@sha256:replace-with-the-pulled-image-digest
# Use the NAS private IP and an unused unprivileged port.
MINDSYNC_HTTPS_IP=192.168.1.10
MINDSYNC_HTTPS_PORT=8443
MINDSYNC_UPSTREAM=127.0.0.1:8080
# Match the owner of the local data and config directories.
MINDSYNC_RUN_UID=1000
MINDSYNC_RUN_GID=1000
