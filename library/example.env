# MindSync library definition template.
#
# One library = one server instance + one data directory + one owner account.
# Instead of editing a partial copy of library/<name>.env, use:
#   sh scripts/add-library.sh <name> <port> <data-dir>
# The script prompts for credentials and prepares directories, ownership, and startup.
#
# Each library needs unique MINDSYNC_PORT and MINDSYNC_DATA_DIR values.

# Library name. add-library.sh assigns Compose project and container names.
# The first library uses mindsync / mindsync / postgres; later libraries use suffixes.
# Always pass -p using MINDSYNC_PROJECT from the library environment file.
MINDSYNC_LIBRARY=example

# Host port published for this library.
MINDSYNC_PORT=8080

# Bind address. Use the NAS IP or 0.0.0.0 for LAN access.
# Use 127.0.0.1 for local or reverse-proxy access.
MINDSYNC_BIND_ADDRESS=0.0.0.0

# Dedicated absolute data path: vault/ is the readable tree, objects/ stores history.
MINDSYNC_DATA_DIR=/vol1/1000/library/example

# Container identity. Named volumes use the image UID 10001.
# For bind mounts, add-library.sh uses the data directory owner.
# fnOS storage ACLs may reject unknown user IDs.
MINDSYNC_RUN_UID=10001
MINDSYNC_RUN_GID=10001

# File size limit in bytes, default 50 MiB. Allow matching request sizes in the reverse proxy.
MINDSYNC_MAX_FILE_BYTES=52428800

# Grace period for manual collection of unreferenced objects, in seconds; default 7 days.
MINDSYNC_GC_GRACE_SECONDS=604800

# Compose project and container names, assigned by add-library.sh.
# The first library uses project mindsync and containers mindsync / postgres.
# Later libraries use suffixes because container names must be unique on the host.
MINDSYNC_PROJECT=mindsync
MINDSYNC_CONTAINER_NAME=mindsync
MINDSYNC_POSTGRES_CONTAINER_NAME=postgres

# Overlay files applied after docker/compose.yaml, colon-separated.
# Leave unset for the plain backend. Examples:
#   COMPOSE_FILE=docker/compose.yaml:docker/combined/compose.yaml
#   COMPOSE_FILE=docker/compose.yaml:docker/combined/compose.yaml:docker/rag/compose.yaml
COMPOSE_FILE=docker/compose.yaml

# Persistent server secret for verification-code digests; keep private and backed up.
MINDSYNC_AUTH_SECRET=replace-with-another-random-secret-at-least-32-characters
# Only this mailbox can create the owner account.
MINDSYNC_OWNER_EMAIL=you@example.com
MINDSYNC_PUBLIC_ORIGIN=https://notes.example.com
MINDSYNC_INSECURE_DEVELOPMENT=false
MINDSYNC_TRUSTED_PROXIES=
MINDSYNC_SMTP_HOST=
MINDSYNC_SMTP_PORT=587
MINDSYNC_SMTP_SECURITY=starttls
MINDSYNC_SMTP_USERNAME=
MINDSYNC_SMTP_PASSWORD=
MINDSYNC_SMTP_FROM=MindSync <noreply@example.com>

# PostgreSQL password. Prefer A-Za-z0-9 and - _ . ~ ! @ % ^ & * + = : ; ,
# This avoids special-character issues in the connection URI.
POSTGRES_PASSWORD=
