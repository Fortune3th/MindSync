# Copy to .env. Generate the server secret with: openssl rand -hex 32
# Persistent server secret for verification-code digests; keep private and backed up.
MINDSYNC_AUTH_SECRET=replace-with-another-random-secret-at-least-32-characters
# Set and confirm the password in the web registration flow.
# Only this mailbox can create the owner account.
MINDSYNC_OWNER_EMAIL=you@example.com
MINDSYNC_PUBLIC_ORIGIN=https://notes.example.com
# HTTP and plain SMTP are allowed only in an explicit isolated development deployment.
MINDSYNC_INSECURE_DEVELOPMENT=false
# Trust X-Real-IP only from these comma-separated reverse-proxy IP addresses.
MINDSYNC_TRUSTED_PROXIES=
MINDSYNC_SMTP_HOST=
MINDSYNC_SMTP_PORT=587
MINDSYNC_SMTP_SECURITY=starttls
MINDSYNC_SMTP_USERNAME=
# Single-quote secrets containing $, # or backslashes in Compose environment files.
MINDSYNC_SMTP_PASSWORD=
MINDSYNC_SMTP_FROM=MindSync <noreply@example.com>
POSTGRES_PASSWORD=replace-with-a-random-hex-password
# Bind 127.0.0.1 behind a reverse proxy; set NAS LAN IP for LAN-only access.
MINDSYNC_BIND_ADDRESS=127.0.0.1
MINDSYNC_PORT=8080
MINDSYNC_MAX_FILE_BYTES=52428800

# Manual GC only: protect uncommitted objects for 7 days.
MINDSYNC_GC_GRACE_SECONDS=604800
